# Combell API Credentials
# Get these from your Combell account dashboard
COMBELL_API_KEY=your_api_key_here
COMBELL_API_SECRET=your_api_secret_here

# PFX Password for certificate download
# Choose a strong password - this will be used to encrypt/decrypt the PFX file
# when downloading from Combell API
PFX_PASSWORD=your_secure_password_here

# Optional: Override default directories
# NGINX_SITES_ENABLED_DIR=/etc/nginx/sites-enabled

# Certificate directory - set to match your server's nginx setup
# Default is /etc/nginx/ssl, but many servers use /etc/nginx/certs
NGINX_CERT_DIR=/etc/nginx/certs
